    {
      "name": "提交报修（默认无图；新一笔请清空 idempotencyKey）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"水电\",\n  \"location\": \"A栋101\",\n  \"description\": \"水龙头漏水\",\n  \"urgency\": \"NORMAL\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const p = pm.response.json();",
              "  if (p.code === 0 && p.data) {",
              "    if (p.data.id) pm.collectionVariables.set('orderId', p.data.id);",
              "    if (Number.isInteger(p.data.version)) pm.collectionVariables.set('version', p.data.version);",
              "    if (p.data.imageUrl) pm.collectionVariables.set('imageUrl', p.data.imageUrl);",
              "  }",
              "}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('idempotencyKey')) pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
